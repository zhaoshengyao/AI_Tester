# 环境配置文件
.env
.env.local
.env.*.local
# 例外：projects/ 下的 .env.example 是配置模板，需提交
!projects/*/.env.example

# 测试报告
reports/
test-results/
*.xml
*.html
*.json

# 日志文件
*.log
logs/

# Node.js 依赖
node_modules/
package-lock.json
yarn.lock

# Python 依赖
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.venv/

# 编辑器配置
.vscode/
.idea/
.trae/
*.swp
*.swo

# 操作系统文件
.DS_Store
Thumbs.db

# 执行日志
run-logs/

# 测试批次归档
docs/test-runs/

# 性能测试结果
tests/performance/results/

# 安全测试报告
tests/security/reports/

# Playwright artifacts
tests/ui/test-results/
tests/ui/.auth/

# Locust reports
tests/performance/locust/reports/

# 诊断输出（调试产物，不提交）
tests/ui/diagnose-output/

# 运行时状态文件
scripts/.rerun_state.txt

# 根目录临时脚本（下划线前缀 = 一次性工作脚本）
# 仅保留 5 个流水线活跃脚本，其余自动忽略
_*.py
!_ipd_run_api_pipeline.py
!_gen_api_report.py
!_gen_ui_perf_sec_mat_reports.py
!_ipd_preflight.py
!_run_wr15_cases.py

# 临时输出文件
test-run-output.txt
null